{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/projects", "destination": "/", "permanent": false },
    { "source": "/projects.html", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
